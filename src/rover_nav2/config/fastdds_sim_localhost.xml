<?xml version="1.0" encoding="UTF-8"?>
<!-- Simulation and benchmark only (rover_nav2 benchmark sets it, see PROGRESS.md 2026-11-04).
     Sim only. Loopback has no multicast, so in LOCALHOST mode Fast DDS finds peers by unicast to
     participant ids 0..31 only, and two participants above 31 never meet (40 nodes: 32 seen).
     A 3D stack plus tools passes 32, so Nav2's lifecycle manager missed servers at random. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>udp_wide</transport_id>
      <type>UDPv4</type>
      <maxInitialPeersRange>120</maxInitialPeersRange>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>shm</transport_id>
      <type>SHM</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="rover_sim_wide_peers" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>udp_wide</transport_id>
        <transport_id>shm</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
      <builtin>
        <initialPeersList>
          <locator><udpv4><address>127.0.0.1</address></udpv4></locator>
        </initialPeersList>
      </builtin>
    </rtps>
  </participant>
</profiles>
