<?xml version="1.0"?>
<model>
  <name>MarsyardGround</name>
  <version>1.0</version>
  <sdf version="1.8">model.sdf</sdf>
  <description>
    Carries the regolith albedo map that worlds/marsyard.sdf paints its ground with.
    There is no geometry here: the world declares its own ground, and this exists so
    the texture sits on a model:// path that resolves through the package's
    GZ_SIM_RESOURCE_PATH hook once installed.

    Both the texture and the world are generated. Run tools/make_marsyard.py rather
    than editing either by hand.
  </description>
</model>
