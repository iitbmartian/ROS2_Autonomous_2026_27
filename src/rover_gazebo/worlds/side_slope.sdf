<?xml version="1.0"?>
<!--
  GENERATED by tools/generate_stress_worlds.py -- do not hand-edit, re-run the generator.
  4 m strips tilted about x, rising toward +y, low edge on the ground; the
  centre line is 2*sin(roll) m up (0.416 m at 12 deg, 0.618 m at 18 deg).
  lane y=0: 12 deg, lane y=6: 18 deg, x 2..14 (spawn at the origin stays flat).
-->
<sdf version="1.8">
  <world name="side_slope">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="side_12">
      <static>true</static>
      <pose>8.00000 0.04158 0.22019 0.20944 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.00000 4.00000 0.40000</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.00000 4.00000 0.40000</size></box></geometry>
          <material><ambient>0.2 0.45 0.75 1</ambient><diffuse>0.2 0.45 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="side_18">
      <static>true</static>
      <pose>8.00000 6.06180 0.42782 0.31416 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>12.00000 4.00000 0.40000</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>12.00000 4.00000 0.40000</size></box></geometry>
          <material><ambient>0.75 0.45 0.2 1</ambient><diffuse>0.75 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
