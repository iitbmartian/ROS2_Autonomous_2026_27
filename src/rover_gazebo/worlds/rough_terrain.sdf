<?xml version="1.0"?>
<!--
  GENERATED by tools/generate_stress_worlds.py -- do not hand-edit, re-run the generator.
  Seeded (11) fractal heightfield, 0..0.20 m, x 2..22, y -10..10,
  tapered to ground level at its edges. Collision is the OBJ trimesh in
  worlds/terrain/rough.obj. Start at x=0 and drive in along any lane.
-->
<sdf version="1.8">
  <world name="rough_terrain">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="rough_terrain">
      <static>true</static>
      <pose>0.00000 0.00000 0.00000 0.00000 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><mesh><uri>model://rover_gazebo/worlds/terrain/rough.obj</uri></mesh></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><mesh><uri>model://rover_gazebo/worlds/terrain/rough.obj</uri></mesh></geometry>
          <material><ambient>0.45 0.40 0.35 1</ambient><diffuse>0.45 0.40 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
