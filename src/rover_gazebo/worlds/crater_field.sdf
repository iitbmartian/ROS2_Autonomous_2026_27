<?xml version="1.0"?>
<!--
  GENERATED by tools/make_terrain_worlds.py. Edit that, not this.

  Craters for negative-obstacle detection. Spawn at the origin, craters ahead in x 1.5 to 20,
  y -11 to 11. Each is a bowl a quarter of its diameter deep with a rim 6 percent of its
  diameter high. Every crater from 0.6 m up is wider than the wheel track (0.436 m).
  Centres and diameters:
    (11.98,  10.67)  d 0.3 m
    ( 8.48,   3.10)  d 0.3 m
    ( 3.75, -10.02)  d 0.3 m
    (17.02,  -6.53)  d 0.3 m
    (18.82,  10.90)  d 0.3 m
    (12.91,  10.50)  d 0.3 m
    (16.22,   8.78)  d 0.6 m
    (12.57,   4.48)  d 0.6 m
    ( 9.04,   6.58)  d 0.6 m
    (12.46,   6.64)  d 0.6 m
    ( 2.52,  -9.10)  d 0.6 m
    (17.69,  -9.38)  d 0.6 m
    (15.80,   0.94)  d 0.6 m
    (19.83, -10.56)  d 0.6 m
    ( 8.15,   1.48)  d 1.0 m
    ( 2.79,   7.62)  d 1.0 m
    (14.84,   2.21)  d 1.0 m
    ( 3.71,  -6.09)  d 1.0 m
    (10.79,   6.43)  d 1.0 m
    (11.15,  -1.40)  d 1.0 m
    ( 3.80,   3.18)  d 1.0 m
    (12.03,  -7.52)  d 1.0 m
    (14.86,  -3.91)  d 1.8 m
    (19.44,   4.74)  d 1.8 m
    ( 5.75,  -1.78)  d 1.8 m
    ( 6.55, -10.92)  d 1.8 m
    ( 7.06,  -7.41)  d 1.8 m
    (14.74,  -7.75)  d 3.0 m
    (18.79,  -0.91)  d 3.0 m
    ( 6.95,   5.08)  d 3.0 m

  Declares its systems explicitly for the same reason the other worlds do: the Sensors and Imu
  systems the rover needs are not in Gazebo's default set, and naming any plugin disables the
  default set, so the core trio goes in too.
-->
<sdf version="1.8">
  <world name="crater_field">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 12 0 0 0</pose>
      <diffuse>1.0 0.94 0.86 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.6 0.35 -0.72</direction>
    </light>

    <scene>
      <ambient>0.45 0.42 0.40 1</ambient>
      <background>0.55 0.42 0.34 1</background>
    </scene>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 -1.249 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>400 400</size></plane></geometry>
          <material><ambient>0.45 0.38 0.32 1</ambient><diffuse>0.55 0.45 0.38 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="terrain">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
          <heightmap>
            <uri>model://TerrainCraterField/heightmap.png</uri>
            <size>25.600 25.600 0.9258</size>
            <pos>9.000 0.000 -0.7486</pos>
          </heightmap>
          </geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry>
          <heightmap>
            <uri>model://TerrainCraterField/heightmap.png</uri>
            <size>25.600 25.600 0.9258</size>
            <pos>9.000 0.000 -0.7486</pos>
            <texture>
              <diffuse>model://MarsyardGround/materials/textures/regolith.png</diffuse>
              <normal>model://TerrainFlatNormal/flat_normal.png</normal>
              <size>4</size>
            </texture>
          </heightmap>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
