<?xml version="1.0"?>
<!--
  GENERATED by tools/generate_stress_worlds.py -- do not hand-edit, re-run the generator.
  lane y=0: mu 0.3 slab x 2..12.  lane y=4: split mu, left wheels (y>4) on
  mu 0.2, right on mu 1.0, x 2..12.  lane y=8: 15 deg ramp at mu 0.5 from x=2.
  DART takes the lower of the two surfaces' mu; the wheels are mu 1.0.
-->
<sdf version="1.8">
  <world name="low_friction">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="patch_mu03">
      <static>true</static>
      <pose>7.00000 0.00000 0.00500 0.00000 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.00000 2.00000 0.01000</size></box></geometry>
          <surface><friction><ode><mu>0.3</mu><mu2>0.3</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.00000 2.00000 0.01000</size></box></geometry>
          <material><ambient>0.70 0.85 0.95 1</ambient><diffuse>0.70 0.85 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="split_left_mu02">
      <static>true</static>
      <pose>7.00000 4.50000 0.00500 0.00000 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.00000 1.00000 0.01000</size></box></geometry>
          <surface><friction><ode><mu>0.2</mu><mu2>0.2</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.00000 1.00000 0.01000</size></box></geometry>
          <material><ambient>0.70 0.85 0.95 1</ambient><diffuse>0.70 0.85 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="split_right_mu1">
      <static>true</static>
      <pose>7.00000 3.50000 0.00500 0.00000 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>10.00000 1.00000 0.01000</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>10.00000 1.00000 0.01000</size></box></geometry>
          <material><ambient>0.35 0.6 0.3 1</ambient><diffuse>0.35 0.6 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ramp_mu05">
      <static>true</static>
      <pose>3.50065 8.00000 0.19504 0.00000 -0.26180 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.00000 2.00000 0.40000</size></box></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.00000 2.00000 0.40000</size></box></geometry>
          <material><ambient>0.70 0.85 0.95 1</ambient><diffuse>0.70 0.85 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="ramp_mu05_top">
      <static>true</static>
      <pose>6.39778 8.00000 0.57646 0.00000 0.00000 0.00000</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>3.02000 2.00000 0.40000</size></box></geometry>
          <surface><friction><ode><mu>0.5</mu><mu2>0.5</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>3.02000 2.00000 0.40000</size></box></geometry>
          <material><ambient>0.70 0.85 0.95 1</ambient><diffuse>0.70 0.85 0.95 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
