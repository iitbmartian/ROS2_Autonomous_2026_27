  <!-- the one free suspension coordinate; everything else mimics it -->
  <joint name="FLS_joint" type="revolute">
      <origin xyz="-0.15 -0.3 0.236" rpy="0 0 -0.00563357703574"/>
      <parent link="chassis_link"/>
      <child link="FLS"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.45" upper="0.45" effort="5000.0" velocity="20.0"/>
      <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <!-- decorative; fixed so sdformat folds it into its parent. Nothing
       drives it once the loop it closed is replaced by a torque
       coupling on the rockers themselves. -->
  <joint name="LCON_joint" type="fixed">
      <origin xyz="0 0.06988 0.036" rpy="0 0 0.170998923196"/>
      <parent link="FLS"/>
      <child link="LCON"/>
  </joint>

  <joint name="FLE_joint" type="revolute">
      <origin xyz="-0.22188 -0.02 -0.018" rpy="0 0 0"/>
      <parent link="FLS"/>
      <child link="FLE"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-1.75" upper="1.75" effort="500.0" velocity="20.0"/>
      <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- drive; continuous, the export's effort=0 would lock it solid -->
  <joint name="FLD_joint" type="continuous">
      <origin xyz="0 -0.25263 -0.07" rpy="0 0 0"/>
      <parent link="FLE"/>
      <child link="FLD"/>
      <axis xyz="0 0 1"/>
      <limit effort="500.0" velocity="30.0"/>
      <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- follower: FRS = -1.00774 x FLS, held there by rocker_coupling_node -->
  <joint name="FRS_joint" type="revolute">
      <origin xyz="-0.15 -0.3 -0.236" rpy="0 0 -0.00563357703571"/>
      <parent link="chassis_link"/>
      <child link="FRS"/>
      <axis xyz="0 0 1"/>
      <limit lower="-0.6" upper="0.6" effort="5000.0" velocity="20.0"/>
      <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <!-- decorative; fixed so sdformat folds it into its parent. Nothing
       drives it once the loop it closed is replaced by a torque
       coupling on the rockers themselves. -->
  <joint name="RCON_joint" type="fixed">
      <origin xyz="0.005556326342 0.06965875134 -0.036" rpy="0 0 0.170998923196"/>
      <parent link="FRS"/>
      <child link="RCON"/>
  </joint>

  <joint name="FRE_joint" type="revolute">
      <origin xyz="-0.22188 -0.02 0.018" rpy="0 0 0"/>
      <parent link="FRS"/>
      <child link="FRE"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-1.75" upper="1.75" effort="500.0" velocity="20.0"/>
      <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- drive; continuous, the export's effort=0 would lock it solid -->
  <joint name="FRD_joint" type="continuous">
      <origin xyz="0 -0.25263 0.07" rpy="0 0 0"/>
      <parent link="FRE"/>
      <child link="FRD"/>
      <axis xyz="0 0 1"/>
      <limit effort="500.0" velocity="30.0"/>
      <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- follower: BRS = +0.57716 x FLS, held there by rocker_coupling_node -->
  <joint name="BRS_joint" type="revolute">
      <origin xyz="0.15 -0.3 -0.236" rpy="0 0 0"/>
      <parent link="chassis_link"/>
      <child link="BRS"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.6" upper="0.6" effort="5000.0" velocity="20.0"/>
      <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <joint name="BRE_joint" type="revolute">
      <origin xyz="0.2215792494 -0.03026125989 0.018" rpy="0 0 0"/>
      <parent link="BRS"/>
      <child link="BRE"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-1.75" upper="1.75" effort="500.0" velocity="20.0"/>
      <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- drive; continuous, the export's effort=0 would lock it solid -->
  <joint name="BRD_joint" type="continuous">
      <origin xyz="0.001160750633 -0.2423687401 0.07" rpy="0 0 0"/>
      <parent link="BRE"/>
      <child link="BRD"/>
      <axis xyz="0 0 -1"/>
      <limit effort="500.0" velocity="30.0"/>
      <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- decorative; fixed so sdformat folds it into its parent -->
  <joint name="Rdiffcon2_joint" type="fixed">
      <origin xyz="0.066 0.016 0.04" rpy="0 0 0"/>
      <parent link="BRS"/>
      <child link="Rdiffcon2"/>
  </joint>

  <!-- follower: BLS = -0.57716 x FLS, held there by rocker_coupling_node -->
  <joint name="BLS_joint" type="revolute">
      <origin xyz="0.15 -0.3 0.236" rpy="0 0 0"/>
      <parent link="chassis_link"/>
      <child link="BLS"/>
      <axis xyz="0 0 -1"/>
      <limit lower="-0.6" upper="0.6" effort="5000.0" velocity="20.0"/>
      <dynamics damping="5.0" friction="0.5"/>
  </joint>

  <joint name="BLE_joint" type="revolute">
      <origin xyz="0.22274 -0.02 -0.018" rpy="0 0 0"/>
      <parent link="BLS"/>
      <child link="BLE"/>
      <axis xyz="0 -1 0"/>
      <limit lower="-1.75" upper="1.75" effort="500.0" velocity="20.0"/>
      <dynamics damping="1.0" friction="0.5"/>
  </joint>

  <!-- drive; continuous, the export's effort=0 would lock it solid -->
  <joint name="BLD_joint" type="continuous">
      <origin xyz="0 -0.25263 0.07" rpy="0 0 0"/>
      <parent link="BLE"/>
      <child link="BLD"/>
      <axis xyz="0 0 1"/>
      <limit effort="500.0" velocity="30.0"/>
      <dynamics damping="0.05" friction="0.1"/>
  </joint>

  <!-- decorative; fixed so sdformat folds it into its parent -->
  <joint name="Ldiffcon2_joint" type="fixed">
      <origin xyz="0.066 0.016 -0.04" rpy="0 0 0"/>
      <parent link="BLS"/>
      <child link="Ldiffcon2"/>
  </joint>

  <!-- decorative; fixed so sdformat folds it into its parent. Nothing
       drives it once the loop it closed is replaced by a torque
       coupling on the rockers themselves. -->
  <joint name="Differential_joint" type="fixed">
      <origin xyz="0.19 -0.134 0" rpy="0 0 0"/>
      <parent link="chassis_link"/>
      <child link="Differential"/>
  </joint>

  <!-- decorative; fixed so sdformat folds it into its parent -->
  <joint name="Ldiff_joint" type="fixed">
      <origin xyz="0.026 0 0.196" rpy="0 0 0"/>
      <parent link="Differential"/>
      <child link="Ldiff"/>
  </joint>

  <!-- decorative; fixed so sdformat folds it into its parent -->
  <joint name="Ldiffcon_joint" type="fixed">
      <origin xyz="0 -0.15 0" rpy="0 0 0"/>
      <parent link="Ldiff"/>
      <child link="Ldiffcon"/>
  </joint>

  <!-- decorative; fixed so sdformat folds it into its parent -->
  <joint name="Rdiff_joint" type="fixed">
      <origin xyz="0.026 0 -0.196" rpy="0 0 0"/>
      <parent link="Differential"/>
      <child link="Rdiff"/>
  </joint>

  <!-- decorative; fixed so sdformat folds it into its parent -->
  <joint name="Rdiffcon_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="Rdiff"/>
      <child link="Rdiffcon"/>
  </joint>

</robot>
