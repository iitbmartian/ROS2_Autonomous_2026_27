<?xml version="1.0"?>
<!--
  Gazebo-only additions: contact properties and the systems that let ROS
  talk to the model. Sensor links and plugins live in rover_sensors.xacro.
  Nothing here changes the kinematics.

  Plugin names differ between Gazebo Harmonic and Fortress but nothing else does, so
  the 'sim' argument switches the names and the rest of the file is shared.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="harmonic" value="${sim == 'harmonic'}"/>

  <xacro:property name="odom_plugin"
    value="${'gz-sim-odometry-publisher-system' if harmonic else 'ignition-gazebo-odometry-publisher-system'}"/>
  <xacro:property name="odom_class"
    value="${'gz::sim::systems::OdometryPublisher' if harmonic else 'ignition::gazebo::systems::OdometryPublisher'}"/>
  <xacro:property name="control_plugin"
    value="${'gz_ros2_control-system' if harmonic else 'ign_ros2_control-system'}"/>
  <xacro:property name="control_class"
    value="${'gz_ros2_control::GazeboSimROS2ControlPlugin' if harmonic else 'ign_ros2_control::IgnitionROS2ControlPlugin'}"/>

  <!-- =================================================================
       Wheel contact.

       The wheel STL is a bare cylinder, so the collision primitive in
       rover_body.xacro is exact. Friction is isotropic on purpose: crab and
       spot modes slide the contact patch sideways, and a lower lateral
       coefficient would make those modes behave differently from forward
       driving for no physical reason.
       ================================================================= -->
  <xacro:macro name="wheel_contact" params="name">
    <gazebo reference="${name}">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
      <kp>100000.0</kp>
      <kd>10000.0</kd>
      <minDepth>0.001</minDepth>
      <maxVel>0.1</maxVel>
      <material>Gazebo/DarkGrey</material>
    </gazebo>
  </xacro:macro>

  <xacro:wheel_contact name="FLD"/>
  <xacro:wheel_contact name="FRD"/>
  <xacro:wheel_contact name="BLD"/>
  <xacro:wheel_contact name="BRD"/>

  <gazebo reference="chassis_link">
    <mu1>0.5</mu1>
    <mu2>0.5</mu2>
    <material>Gazebo/Grey</material>
  </gazebo>

  <!-- The connector bars and the differential chain overlap their neighbours by
       design, so nothing in the model is allowed to collide with itself. -->
  <gazebo>
    <self_collide>false</self_collide>
  </gazebo>

<!-- =================================================================
        Ground-truth odometry. This is the reference the wheel odometry and
        the EKF get judged against, not a substitute for either.
        ================================================================= -->
  <gazebo>
    <plugin filename="${odom_plugin}" name="${odom_class}">
      <odom_frame>odom</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>
  </gazebo>

  <!-- =================================================================
       ros2_control hardware bridge. The controller manager runs inside the
       simulator, at the physics rate, and exposes the eight driven joints
       to ordinary ROS controllers.
       ================================================================= -->
  <xacro:if value="${'$(arg ros2_control)' in ['true', 'True', '1']}">
    <gazebo>
      <plugin filename="${control_plugin}" name="${control_class}">
        <parameters>$(arg controllers_file)</parameters>
        <position_proportional_gain>0.12</position_proportional_gain>
      </plugin>
    </gazebo>
  </xacro:if>

</robot>
