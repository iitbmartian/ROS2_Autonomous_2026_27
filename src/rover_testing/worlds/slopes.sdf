<?xml version="1.0"?>
<!--
  Slopes: 24 x 6 m corridor (inner faces x +-12, y +-3) with two hills spanning its full width. Hill 1: 8 degree ramps up to a 0.4 m, 2 m plateau, x -6.0 .. 1.69. Hill 2: 15 degree ramps up to a 0.6 m, 2 m plateau, x 4.0 .. 10.48.

  Generated by rover_testing/worldgen.py; edit there, not here. The template is
  rover_gazebo's empty_world.sdf: same systems and GPS origin, and the same world
  name, which rover_gazebo's bridge config embeds in its Gazebo topic names.
-->
<sdf version="1.6">
  <world name="husarion_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>19.1334</latitude_deg>
      <longitude_deg>72.9133</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0.0000 3.1000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24.4000 0.2000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>24.4000 0.2000 1.0000</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0.0000 -3.1000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>24.4000 0.2000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>24.4000 0.2000 1.0000</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>12.1000 0.0000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2000 6.0000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2000 6.0000 1.0000</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-12.1000 0.0000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2000 6.0000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2000 6.0000 1.0000</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hill1_ramp_up">
      <static>true</static>
      <pose>-4.5421 0.0000 -0.0476 0.000000 -0.139626 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.8741 5.9800 0.5000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.8741 5.9800 0.5000</size></box></geometry>
          <material><ambient>0.6 0.5 0.35 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hill1_plateau">
      <static>true</static>
      <pose>-2.1539 0.0000 0.2000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0000 5.9800 0.4000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0000 5.9800 0.4000</size></box></geometry>
          <material><ambient>0.5 0.42 0.3 1</ambient><diffuse>0.5 0.42 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hill1_ramp_down">
      <static>true</static>
      <pose>0.2344 0.0000 -0.0476 0.000000 0.139626 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.8741 5.9800 0.5000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.8741 5.9800 0.5000</size></box></geometry>
          <material><ambient>0.6 0.5 0.35 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hill2_ramp_up">
      <static>true</static>
      <pose>5.1843 0.0000 0.0585 0.000000 -0.261799 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.3182 5.9800 0.5000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.3182 5.9800 0.5000</size></box></geometry>
          <material><ambient>0.6 0.5 0.35 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hill2_plateau">
      <static>true</static>
      <pose>7.2392 0.0000 0.3000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.0000 5.9800 0.6000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.0000 5.9800 0.6000</size></box></geometry>
          <material><ambient>0.5 0.42 0.3 1</ambient><diffuse>0.5 0.42 0.3 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="hill2_ramp_down">
      <static>true</static>
      <pose>9.2941 0.0000 0.0585 0.000000 0.261799 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>2.3182 5.9800 0.5000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>2.3182 5.9800 0.5000</size></box></geometry>
          <material><ambient>0.6 0.5 0.35 1</ambient><diffuse>0.6 0.5 0.35 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
