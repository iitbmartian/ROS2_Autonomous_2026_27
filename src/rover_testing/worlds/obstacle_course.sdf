<?xml version="1.0"?>
<!--
  Obstacle course: 16 x 10 m arena (inner faces x +-8, y +-5), four 1 m obstacles in a slalom between x -6.5 and 6.5, and a low 8 cm plate at (-5.5, -3).

  Generated by rover_testing/worldgen.py; edit there, not here. The template is
  rover_gazebo's empty_world.sdf: same systems and GPS origin, and the same world
  name, which rover_gazebo's bridge config embeds in its Gazebo topic names.
-->
<sdf version="1.6">
  <world name="husarion_world">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-navsat-system" name="gz::sim::systems::NavSat" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>19.1334</latitude_deg>
      <longitude_deg>72.9133</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>100 100</size></plane></geometry>
          <material>
            <ambient>0.8 0.8 0.8 1</ambient>
            <diffuse>0.8 0.8 0.8 1</diffuse>
            <specular>0.8 0.8 0.8 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="wall_north">
      <static>true</static>
      <pose>0.0000 5.1000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16.4000 0.2000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16.4000 0.2000 1.0000</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_south">
      <static>true</static>
      <pose>0.0000 -5.1000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>16.4000 0.2000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>16.4000 0.2000 1.0000</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_east">
      <static>true</static>
      <pose>8.1000 0.0000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2000 10.0000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2000 10.0000 1.0000</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="wall_west">
      <static>true</static>
      <pose>-8.1000 0.0000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.2000 10.0000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.2000 10.0000 1.0000</size></box></geometry>
          <material><ambient>0.55 0.55 0.6 1</ambient><diffuse>0.55 0.55 0.6 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_a">
      <static>true</static>
      <pose>-3.0000 0.6000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.2000 1.2000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.2000 1.2000 1.0000</size></box></geometry>
          <material><ambient>0.75 0.35 0.2 1</ambient><diffuse>0.75 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_b">
      <static>true</static>
      <pose>0.5000 -2.6000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.0000 2.5000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.0000 2.5000 1.0000</size></box></geometry>
          <material><ambient>0.75 0.35 0.2 1</ambient><diffuse>0.75 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="pillar_c">
      <static>true</static>
      <pose>1.0000 1.8000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><cylinder><radius>0.5000</radius><length>1.0000</length></cylinder></geometry></collision>
        <visual name="visual">
          <geometry><cylinder><radius>0.5000</radius><length>1.0000</length></cylinder></geometry>
          <material><ambient>0.75 0.35 0.2 1</ambient><diffuse>0.75 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_d">
      <static>true</static>
      <pose>4.0000 0.2000 0.4000 0.000000 0.000000 0.523599</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5000 1.0000 0.8000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5000 1.0000 0.8000</size></box></geometry>
          <material><ambient>0.75 0.35 0.2 1</ambient><diffuse>0.75 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="block_e">
      <static>true</static>
      <pose>-1.0000 3.6000 0.5000 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>0.8000 0.8000 1.0000</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>0.8000 0.8000 1.0000</size></box></geometry>
          <material><ambient>0.75 0.35 0.2 1</ambient><diffuse>0.75 0.35 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <model name="low_plate">
      <static>true</static>
      <pose>-5.5000 -3.0000 0.0400 0.000000 0.000000 0.000000</pose>
      <link name="link">
        <collision name="collision"><geometry><box><size>1.5000 1.5000 0.0800</size></box></geometry></collision>
        <visual name="visual">
          <geometry><box><size>1.5000 1.5000 0.0800</size></box></geometry>
          <material><ambient>0.35 0.5 0.75 1</ambient><diffuse>0.35 0.5 0.75 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
