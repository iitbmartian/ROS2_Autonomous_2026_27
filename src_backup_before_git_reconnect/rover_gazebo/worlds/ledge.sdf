<?xml version="1.0"?>
<!--
  A ramp onto a long 10 cm ledge, under the left-hand wheels only.

  Drive forward along +x. The left track climbs a gentle wedge and then stays 10 cm
  up for sixteen metres, so the rover has to hold a sustained step across its track.
  A suspension with a working differential absorbs most of it in the rockers and
  passes only part of it to the chassis as roll. One without hands over all of it.

  Declares its systems explicitly because the Sensors and Imu systems the rover's
  sensors need are not in Gazebo's default set, and listing any plugin disables the
  default set, so the core trio goes in too.
-->
<sdf version="1.8">
  <world name="ledge">

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <physics name="1ms" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <gravity>0 0 -9.80665</gravity>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.25 0.25 0.25 1</specular>
      <direction>-0.5 0.2 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>200 200</size></plane></geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- wedge: top face runs from ground at x=1.0 up to 10 cm at x=3.0 -->
    <model name="ledge_ramp">
      <static>true</static>
      <pose>2.01 0.218 -0.1497 0 -0.05 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>2.0 0.5 0.4</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>2.0 0.5 0.4</size></box></geometry>
          <material><ambient>0.75 0.45 0.2 1</ambient><diffuse>0.75 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- the ledge itself: 10 cm high, from x = 3 to x = 19 -->
    <model name="ledge_top">
      <static>true</static>
      <pose>11.0 0.218 0.05 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>16.0 0.5 0.10</size></box></geometry>
          <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><box><size>16.0 0.5 0.10</size></box></geometry>
          <material><ambient>0.75 0.45 0.2 1</ambient><diffuse>0.75 0.45 0.2 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
