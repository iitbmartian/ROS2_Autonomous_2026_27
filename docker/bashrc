# Sourced from ~/.bashrc of the container user (interactive shells, including
# `docker compose exec`, which bypasses the entrypoint).
source "/opt/ros/${ROS_DISTRO}/setup.bash"
[ -f /ws/install/setup.bash ] && source /ws/install/setup.bash
[ -f /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash ] && \
  source /usr/share/colcon_argcomplete/hook/colcon-argcomplete.bash

export ROS_DOMAIN_ID="${ROS_DOMAIN_ID:-0}"
export RCUTILS_COLORIZED_OUTPUT=1

# Rebuild and re-source in one go:  cb  or  cb --packages-select rover_slam
cb() { (cd /ws && colcon build "$@") && source /ws/install/setup.bash; }

PS1='\[\e[1;33m\](rover-docker)\[\e[0m\] \[\e[1;34m\]\w\[\e[0m\]\$ '

if [ -z "${ROVER_BANNER_SHOWN:-}" ]; then
  export ROVER_BANNER_SHOWN=1
  if [ -d /usr/local/zed ]; then flavour="ZED/NVIDIA"; else flavour="CPU (ZED wrapper skipped)"; fi
  echo "ROS 2 ${ROS_DISTRO} dev container, ${flavour}. Workspace: /ws"
  [ -f /ws/install/setup.bash ] || echo "Workspace not built yet: run 'cb' (colcon build)."
fi
